/* ---------- 顶部 ---------- */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* 背景渐变由 page 统一铺满（含状态栏），这里只放内容 */
.hero {
  width: 100%;
  flex-shrink: 0;
  padding: 32rpx 32rpx 36rpx;
  box-sizing: border-box;
}

.hero-title {
  font-family: 'Kaiti SC', 'STKaiti', 'KaiTi', serif;
  font-size: var(--fs-num);
  font-weight: 700;
  color: #a04a63;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: #c07a8d;
}

/* ---------- 筛选 ---------- */
.tab-row {
  display: flex;
  flex-shrink: 0;
  padding: 20rpx 24rpx;
}

.tab {
  flex: 1;
  margin: 0 8rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--text-2);
  background: var(--card);
  border-radius: 999rpx;
  box-shadow: var(--shadow);
}

.tab.on {
  color: #fff;
  font-weight: 600;
  background: linear-gradient(135deg, #f7a8bc, #e0678a);
}

/* ---------- 列表 ---------- */
.list {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.list-pad {
  height: 40rpx;
}

.record {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.rec-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-name {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-state {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  font-size: var(--fs-xs);
  color: #e08b3c;
  background: #fff3e2;
  border-radius: 999rpx;
}

.rec-state.done {
  color: #2e9e5b;
  background: var(--success-light);
}

.rec-meta {
  margin-top: 8rpx;
  font-size: var(--fs-xs);
  color: var(--text-2);
}

.rec-price {
  margin-top: 6rpx;
  font-size: var(--fs-xs);
  color: var(--text-3);
}

.rec-remark {
  margin-top: 8rpx;
  font-size: var(--fs-xs);
  color: var(--text-2);
}

.rec-rate {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.rec-stars {
  font-size: var(--fs-base);
  color: #ffb400;
  letter-spacing: 2rpx;
}

.rec-score {
  margin-left: 12rpx;
  font-size: var(--fs-xs);
  color: var(--text-3);
}

.rec-comment {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  font-size: var(--fs-xs);
  color: var(--text-1);
  background: #fdf1f4;
  border-radius: 12rpx;
}

.rec-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.rec-btn {
  margin-left: 16rpx;
  padding: 12rpx 28rpx;
  font-size: var(--fs-sm);
  color: var(--primary-dark);
  background: var(--primary-light);
  border-radius: 999rpx;
}

.rec-btn.del {
  color: var(--text-2);
  background: #f2f3f5;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: var(--fs-sm);
  color: var(--text-3);
}

/* ---------- 评价打分弹层 ---------- */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.rate-box {
  width: 600rpx;
  padding: 36rpx 32rpx 28rpx;
  text-align: center;
  background: #fff;
  border-radius: 28rpx;
}

.rate-title {
  font-size: var(--fs-md);
  font-weight: 600;
  color: var(--text-1);
}

.rate-stars {
  margin-top: 24rpx;
}

.rate-star {
  padding: 0 10rpx;
  font-size: var(--fs-num);
  color: #e0e0e0;
}

.rate-star.on {
  color: #ffb400;
}

.rate-hint {
  height: 36rpx;
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--primary-dark);
}

.rate-input {
  width: 100%;
  height: 140rpx;
  margin-top: 16rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: var(--fs-sm);
  text-align: left;
  background: #faf7f8;
  border-radius: 16rpx;
}

.rate-btns {
  display: flex;
  margin-top: 24rpx;
}

.rate-btn {
  flex: 1;
  margin: 0 10rpx;
  padding: 18rpx 0;
  font-size: var(--fs-base);
  color: var(--text-2);
  background: #f2f3f5;
  border-radius: 999rpx;
}

.rate-btn.solid {
  color: #fff;
  background: linear-gradient(135deg, #f7a8bc, #e0678a);
}
